# Firebase yapılandırması (isteğe bağlı) — mevcut sevkiyat-yukleme-dashboard projesi
# varsayılan olarak gömülüdür. Farklı bir projeye geçmek için bu değişkenleri doldurun
# ve dosyayı .env.local olarak kaydedin.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MSG_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database URL (farklı proje/bölge kullanıyorsanız)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
