rules_version = '2';

// YATSAN İhracat Yükleme Paneli — Firestore güvenlik kuralları
// Panel giriş kapısı (Firebase Auth) kullandığı için tüm erişim
// yalnızca oturum açmış kullanıcılara açıktır.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
