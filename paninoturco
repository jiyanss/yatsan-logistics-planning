/* ============ hesaplar ============ */
const ingById = id => state.ingredients.find(i=>i.id===id);
const recUnit = ing => UNITS[ing.punit].rec;
function lineCost(ing,amount){ if(!ing) return 0; return ing.price*amount/UNITS[ing.punit].f }
function productCost(p){ return (p.recipe||[]).reduce((t,r)=>t+lineCost(ingById(r.ingredientId),r.amount),0) }
function metrics(p){ const c=productCost(p); return {cost:c, profit:p.price-c, margin:p.price>0?(p.price-c)/p.price*100:0} }
function marginColor(m){ return m<35?'var(--accent)':(m<50?'var(--amber)':'var(--green)') }
function computeToday(){
  const s=state.sales.filter(x=>x.date===isoLocal());
  const rev=s.reduce((t,x)=>t+x.qty*x.unitPrice,0);
  const cost=s.reduce((t,x)=>t+x.qty*x.unitCost,0);
  return {qty:s.reduce((t,x)=>t+x.qty,0), rev, profit:rev-cost};
}
function analytics(days){
  const from=isoDaysAgo(days-1);
  const sales=state.sales.filter(s=>s.date>=from);
  const rev=sales.reduce((t,s)=>t+s.qty*s.unitPrice,0);
  const cost=sales.reduce((t,s)=>t+s.qty*s.unitCost,0);
  const profit=rev-cost;
  const qty=sales.reduce((t,s)=>t+s.qty,0);
  const daily=[];
  for(let i=13;i>=0;i--){
    const date=isoDaysAgo(i);
    const ds=state.sales.filter(s=>s.date===date);
    const dr=ds.reduce((t,s)=>t+s.qty*s.unitPrice,0);
    const dc=ds.reduce((t,s)=>t+s.qty*s.unitCost,0);
    daily.push({date,rev:dr,profit:dr-dc,qty:ds.reduce((t,s)=>t+s.qty,0)});
  }
  const bp={};
  sales.forEach(s=>{const o=bp[s.productId]=bp[s.productId]||{name:s.name,qty:0,rev:0,profit:0};o.qty+=s.qty;o.rev+=s.qty*s.unitPrice;o.profit+=s.qty*(s.unitPrice-s.unitCost)});
  const tops=Object.values(bp).sort((a,b)=>b.qty-a.qty);
  return {sales,rev,cost,profit,qty,daily,tops};
}

/* ============ toast / modal / onay ============ */
function toast(msg,icon='info',ok=false){
  const t=document.createElement('div');
  t.className='toast'+(ok?' ok':'');
  t.innerHTML=`<i data-lucide="${icon}"></i><span>${msg}</span>`;
  $('#toastRoot').appendChild(t); icons();
  setTimeout(()=>{t.classList.add('out');setTimeout(()=>t.remove(),320)},2800);
}
function openModal(html){
  $('#modalRoot').innerHTML=`<div class="overlay" id="ovl"><div class="sheet">${html}</div></div>`;
  document.body.style.overflow='hidden';
  $('#ovl').addEventListener('click',e=>{ if(e.target.id==='ovl') closeModal(); });
  document.querySelectorAll('[data-close]').forEach(b=>b.onclick=closeModal);
  icons();
}
function closeModal(){ $('#modalRoot').innerHTML=''; document.body.style.overflow=''; ui.editing=null; }
function confirmDialog(title,msg,okLabel,cb){
  $('#confirmRoot').innerHTML=`
    <div class="overlay" id="covl"><div class="sheet" style="max-width:400px">
      <h3 class="serif" style="font-size:20px;margin-bottom:8px">${title}</h3>
      <p style="font-size:14px;line-height:1.55;color:var(--ink-2)">${msg}</p>
      <div class="sheet-actions">
        <button class="btn ghost" id="cNo">Vazgeç</button>
        <button class="btn danger" id="cOk">${okLabel}</button>
      </div>
    </div></div>`;
  document.body.style.overflow='hidden';
  $('#covl').addEventListener('click',e=>{ if(e.target.id==='covl') closeConfirm(); });
  $('#cNo').onclick=closeConfirm;
  $('#cOk').onclick=()=>{ closeConfirm(); cb(); };
}
function closeConfirm(){ $('#confirmRoot').innerHTML=''; if(!$('#modalRoot').innerHTML) document.body.style.overflow=''; }

