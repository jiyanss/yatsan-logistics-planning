      <div class="date-pick"><label>Satış günü</label><input type="date" id="saleDate" value="${date}"></div>
    </div>
    <p class="sub" style="margin-bottom:4px"><b>${dateLabel(date)}</b> · ${totQty?`${totQty} adet · ciro ${fmt0(totRev)} · kâr ${fmt0(totRev-totCost)}`:'kayıt yok'}</p>

    <p class="sell-hint">Ürünlere dokunarak adet ekleyin, sonra «Güne İşle» ile kaydedin.</p>
    ${state.products.length===0
      ? emptyBlock('sandwich','Kasa için önce ürün gerekli.','Ürünler sekmesinden menünüzü oluşturun.',"setTab('menu')","Ürünlere git")
      : `<div class="sell-grid" id="sellGrid">${state.products.map(p=>{
          const m=metrics(p);
          return `<button class="sell-btn" data-p="${p.id}">
            <span class="n">${p.name}</span>
            <span class="f"><span class="pr">${fmt0(p.price)}</span><span class="cs">kâr ${fmt0(m.profit)}</span></span>
            <span class="qbadge" style="display:none"></span>
          </button>`}).join('')}</div>`}

    <div class="charge" id="chargeBar">
      <div class="info"><span class="lbl">${date===isoLocal()?'Bugüne':'('+dateLabel(date)+') gününe'} işlenecek</span>
      <span id="cbInfo"></span></div>
      <button class="btn clear" id="cbClear">Temizle</button>
      <button class="btn go" id="cbGo"><i data-lucide="check"></i>Güne İşle</button>
    </div>

    <div class="sec-head"><h3 class="serif">Gün kayıtları</h3><span class="sub">ürün bazında toplam</span></div>
    ${groups.length? `<div class="rows">`+groups.map(([pid,o])=>`
      <div class="row">
        <div class="grow"><b>${o.name}</b><span class="subline">${o.qty} adet · ort. ${fmt(o.rev/o.qty)}</span></div>
        <span class="num">${fmt(o.rev)}</span>
        <button class="icon-btn" data-delsale="${pid}" title="Sil"><i data-lucide="trash-2"></i></button>
      </div>`).join('')+
      `<div class="row" style="border-bottom:none"><div class="grow"><b>Gün toplamı</b><span class="subline">${totQty} adet · maliyet ${fmt0(totCost)}</span></div>
      <span class="num" style="font-size:17px;color:var(--accent)">${fmt0(totRev)}</span></div></div>`
      : `<div class="empty" style="padding:22px">Bu gün için kayıt yok.</div>`}`;

  $('#saleDate').onchange=e=>{ ui.saleDate=e.target.value||isoLocal(); ui.counter={}; renderSales(); };
  const sellGrid=$('#sellGrid');
  if(sellGrid) sellGrid.onclick=e=>{
    const b=e.target.closest('[data-p]'); if(!b)return;
    const id=b.dataset.p;
    ui.counter[id]=(ui.counter[id]||0)+1;
    const q=ui.counter[id];
    const badge=b.querySelector('.qbadge');
    badge.style.display='flex'; badge.textContent=q;
    badge.classList.remove('pulse'); void badge.offsetWidth; badge.classList.add('pulse');
    b.classList.remove('pulse'); void b.offsetWidth; b.classList.add('pulse');
    updateCharge();
  };
  const updateCharge=()=>{
    const entries=Object.entries(ui.counter);
    const bar=$('#chargeBar');
    if(!entries.length){ bar.classList.remove('show'); return; }
    let q=0,rev=0,prof=0;
    entries.forEach(([pid,qq])=>{ const p=state.products.find(x=>x.id===pid); if(!p)return;
      const c=productCost(p); q+=qq; rev+=qq*p.price; prof+=qq*(p.price-c); });
    $('#cbInfo').innerHTML=`<b>${q}</b> adet · ciro <b>${fmt0(rev)}</b> · kâr <b style="color:#A9C58F">${fmt0(prof)}</b>`;
    bar.classList.add('show');
  };
  updateCharge();
  $('#cbClear').onclick=()=>{ ui.counter={}; renderSales(); };
  $('#cbGo').onclick=()=>{
    const entries=Object.entries(ui.counter).filter(([,q])=>q>0);
    if(!entries.length)return;
    let q=0,rev=0;
    entries.forEach(([pid,qq])=>{
      const p=state.products.find(x=>x.id===pid); if(!p)return;
      state.sales.push({id:uid(),date:ui.saleDate,productId:pid,name:p.name,qty:qq,unitPrice:p.price,unitCost:Math.round(productCost(p)*100)/100});
      q+=qq; rev+=qq*p.price;
    });
    ui.counter={}; save(); renderSales();
    toast(`${q} adet işlendi · ${fmt0(rev)}`,'check',true);
  };
  v.querySelectorAll('[data-delsale]').forEach(b=>{
    b.onclick=()=>{
      const pid=b.dataset.delsale;
      const g2=g[pid];
      confirmDialog('Kaydı sil',`${dateLabel(date)} günündeki «${g2.name}» satışlarının tamamı (${g2.qty} adet) silinecek.`,'Sil',()=>{
        state.sales=state.sales.filter(s=>!(s.date===date&&s.productId===pid));
        save(); renderSales(); toast('Kayıt silindi.','trash-2');
      });
    };
  });
}

/* ============ ANALİZ ============ */
function renderAnalytics(){
  const v=$('#view');
  const days=ui.period==='today'?1:ui.period;
  const label=ui.period==='today'?'Bugün':`Son ${ui.period} gün`;
  const an=analytics(days);
  const margin=an.rev>0?an.profit/an.rev*100:0;
  const avg=an.qty>0?an.rev/an.qty:0;
  const maxQ=Math.max(...an.tops.map(t=>t.qty),1);
  const insights=buildInsights(an);
  const capDefault='Detay için bir güne dokunun.';

  v.innerHTML=`
    <div class="page-head">
      <div><div class="eyebrow">Performans</div><h2 class="serif">Rakamlar</h2></div>
      <div class="seg" id="pSeg">
        <button data-p="today" class="${ui.period==='today'?'on':''}">Bugün</button>
        <button data-p="7" class="${ui.period===7?'on':''}">7 Gün</button>
        <button data-p="30" class="${ui.period===30?'on':''}">30 Gün</button>
      </div>
    </div>

    <section class="sum-block">
      <div class="sum-main">
        <div class="eyebrow">Brüt Kâr · ${label}</div>
        <div class="sum-big serif" style="color:${an.profit>=0?'var(--ink)':'var(--accent)'}">${fmt0(an.profit)}</div>
        <p class="sub">Ortalama brüt marj <b style="color:${marginColor(margin)}">${pct(margin)}</b>${an.qty?` · ${an.qty} adet`:''}</p>
      </div>
      <div class="sum-side">
        <div class="ss-row"><span>Ciro</span><b>${fmt0(an.rev)}</b></div>
        <div class="ss-row"><span>Malzeme maliyeti</span><b>${fmt0(an.cost)}</b></div>
        <div class="ss-row"><span>Satış adedi</span><b>${an.qty}</b></div>
        <div class="ss-row"><span>Ortalama sepet</span><b>${fmt0(avg)}</b></div>
      </div>
    </section>

    <section>
      <div class="sec-head"><h3 class="serif">Günlük akış</h3><span class="sub">son 14 gün · kısmi = kâr</span></div>
      <div id="chartWrap">${chartSVG(an.daily)}</div>
      <div class="chart-cap" id="chartCap">${capDefault}</div>
    </section>

    <section>
      <div class="sec-head"><h3 class="serif">Ürün sıralaması</h3><span class="sub">${label.toLowerCase()} · adete göre</span></div>
      ${an.tops.length? an.tops.map(t=>`
        <div class="tp">
          <div class="tp-h"><b>${t.name}</b><span>${t.qty} adet</span></div>
          <div class="tp-bar"><i style="width:${t.qty/maxQ*100}%"></i></div>
          <div class="tp-m">
            <span>Ciro <b>${fmt0(t.rev)}</b></span>
            <span>Kâr <b style="color:var(--green)">${fmt0(t.profit)}</b></span>
            <span>Marj <b>${pct(t.rev?t.profit/t.rev*100:0)}</b></span>
          </div>
        </div>`).join('')
      : `<div class="empty" style="padding:22px">Bu dönemde kayıtlı satış yok.</div>`}
    </section>

    <section>
      <div class="sec-head"><h3 class="serif">İçgörüler</h3><span class="sub">otomatik değerlendirme</span></div>
      <div>${insights.map(i=>`
        <div class="ins"><span class="ins-ic ${i.tone}"><i data-lucide="${i.icon}"></i></span><p>${i.text}</p></div>`).join('')}</div>
    </section>`;

  $('#pSeg').onclick=e=>{ const b=e.target.closest('[data-p]'); if(!b)return;
    ui.period=b.dataset.p==='today'?'today':+b.dataset.p; renderAnalytics(); icons(); };
  $('#chartWrap').onclick=e=>{
    const bar=e.target.closest('g.bar'); if(!bar)return;
    const d=an.daily[+bar.dataset.di];
    $('#chartCap').innerHTML=`<b>${dateLabel(d.date)}</b> · ${d.qty} adet · ciro <b>${fmt0(d.rev)}</b> · kâr <b style="color:var(--green)">${fmt0(d.profit)}</b>`;
  };
}
function chartSVG(daily){
  const W=720,H=210,pl=6,pr=6,pt=10,pb=26;
  const iw=W-pl-pr, ih=H-pt-pb;
  const max=Math.max(...daily.map(d=>d.rev),100);
  const bw=iw/daily.length;
  let s='';
  daily.forEach((d,i)=>{
    const x=pl+i*bw+bw*0.2, w=bw*0.6;
    if(d.rev>0){
      const rh=Math.max(d.rev/max*ih,3), y=pt+ih-rh;
      const ph=Math.max(rh*(d.profit/d.rev),1);
      s+=`<g class="bar" data-di="${i}">
        <rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${w.toFixed(1)}" height="${rh.toFixed(1)}" rx="3.5" fill="#C4432B"/>
        <rect x="${x.toFixed(1)}" y="${(y+rh-ph).toFixed(1)}" width="${w.toFixed(1)}" height="${ph.toFixed(1)}" rx="2.5" fill="#262019"/>
      </g>`;
    }else{
      s+=`<rect x="${x.toFixed(1)}" y="${pt+ih-2}" width="${w.toFixed(1)}" height="2" rx="1" fill="#D3C7AD"/>`;
    }
    if(i%3===0||i===daily.length-1){
      const dl=new Date(d.date+'T12:00:00');
      s+=`<text x="${(x+w/2).toFixed(1)}" y="${H-8}" text-anchor="middle" font-size="10" fill="#8A7E6C" font-family="Space Grotesk">${dl.getDate()}.${dl.getMonth()+1}</text>`;
    }
  });
  return `<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;display:block">${s}</svg>`;
}
function buildInsights(an){
  const out=[];
  if(!an.qty) return [{icon:'info',tone:'info',text:'Bu dönemde kayıtlı satış yok. Satış sekmesinden işlem girerek analizi besleyin.'}];
  const top=an.tops[0];
  if(top) out.push({icon:'flame',tone:'warn',text:`«${top.name}» ${top.qty} adet ile en çok satılan ürün (ciro ${fmt0(top.rev)}).`});
  const mostP=[...an.tops].sort((a,b)=>b.profit-a.profit)[0];
  if(mostP&&an.profit>0) out.push({icon:'coins',tone:'good',text:`En çok kârı «${mostP.name}» getirdi: ${fmt0(mostP.profit)} — toplam kârın %${Math.round(mostP.profit/an.profit*100)}'i.`});
  state.products.forEach(p=>{
    const m=metrics(p);
    if(m.margin<40) out.push({icon:'triangle-alert',tone:'warn',text:`«${p.name}» marjı yalnızca ${pct(m.margin)} (maliyet ${fmt(m.cost)} / fiyat ${fmt(p.price)}). Fiyatı ya da porsiyonları gözden geçirin.`});
  });
  const soldIds=new Set(an.sales.map(s=>s.productId));
  const silent=state.products.filter(p=>!soldIds.has(p.id));
  if(silent.length&&state.products.length>1)
    out.push({icon:'info',tone:'info',text:`${silent.map(p=>'«'+p.name+'»').join(', ')} bu dönemde hiç satılmadı — menüden çıkarmayı düşünün.`});
  /* DÜZELTME: "margin" burada tanımlı değildi — başka fonksiyondaki değişken kullanılmıştı; şimdi kendi değeri hesaplanıyor */
  const margin=an.rev>0?an.profit/an.rev*100:0;
  if(margin>=50) out.push({icon:'lightbulb',tone:'good',text:`Genel brüt marjınız ${pct(margin)} — sandviç işletmeleri için sağlıklı bir aralıkta.`});
  return out.slice(0,6);
}

/* ============ VERİ YÖNETİMİ ============ */
function openDataModal(){
  openModal(`
    <div class="sheet-head"><h3 class="serif">Veri Yönetimi</h3><button class="icon-btn" data-close><i data-lucide="x"></i></button></div>
    <p class="hint" style="margin-top:10px">Tüm malzeme, ürün ve satış verileri yalnızca bu cihazın tarayıcısında saklanır. Telefon değiştirirken ya da tarayıcı verisi temizlenirken kaybolmaması için düzenli yedek alın.</p>
    <div class="sheet-actions" style="margin-top:16px">
      <button class="btn ghost" id="dExp"><i data-lucide="download"></i>JSON İndir</button>
      <button class="btn ghost" id="dImp"><i data-lucide="upload"></i>JSON Yükle</button>
      <input type="file" id="dFile" accept=".json,application/json" hidden>
    </div>
    <div class="f-div"></div>
    <label class="f" style="color:var(--accent)">Tehlikeli bölge</label>
    <div class="sheet-actions" style="margin-top:8px">
      <button class="btn ghost" id="dSeed">Örnek verilere dön</button>
      <button class="btn danger" id="dWipe">Tümünü sil</button>
    </div>`);
  $('#dExp').onclick=exportJSON;
  $('#dImp').onclick=()=>$('#dFile').click();
  $('#dFile').onchange=e=>{
    const f=e.target.files[0]; if(!f)return;
    const rd=new FileReader();
    rd.onload=()=>{
      try{
        const d=JSON.parse(rd.result);
        if(!Array.isArray(d.ingredients)||!Array.isArray(d.products)||!Array.isArray(d.sales)) throw 0;
        state=d; save(); closeModal(); renderView(); toast('Yedek geri yüklendi.','check',true);
      }catch(_){ toast('Dosya okunamadı — geçerli bir PaninoTurco yedeği değil.','triangle-alert'); }
    };
    rd.readAsText(f);
  };
  $('#dSeed').onclick=()=>confirmDialog('Örnek verilere dön','Mevcut tüm malzeme, ürün ve satışlar silinip örnek verilerle değiştirilecek.','Sıfırla',()=>{
    state=fresh(); save(); closeModal(); renderView(); toast('Örnek veriler yüklendi.','check',true);
  });
  $('#dWipe').onclick=()=>confirmDialog('Tüm verileri sil','Malzemeler, ürünler ve tüm satış kayıtları kalıcı olarak silinecek.','Hepsini sil',()=>{
    state={ingredients:[],products:[],sales:[]}; save(); closeModal(); renderView(); toast('Tüm veriler silindi.','trash-2');
  });
}
function exportJSON(){
  const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='paninoturco-yedek-'+isoLocal()+'.json';
  a.click(); URL.revokeObjectURL(a.href);
  toast('Yedek dosyası indirildi.','download',true);
}

/* ============ başlat ============ */
renderNav(); renderView();
if(lsGet(LS+'_hi')===null){
  lsSet(LS+'_hi','1');
  setTimeout(()=>toast('Örnek verilerle başladık — Veri menüsünden temizleyip kendi işletmenizi kurabilirsiniz.','info'),700);
}
if(storageBlocked){
  setTimeout(()=>toast('Tarayıcı depolamasına erişilemiyor — veriler sayfayı kapatınca silinir.','triangle-alert'),1500);
}
</script>
