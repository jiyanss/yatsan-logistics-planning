function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}

function seed(){
  const I=(name,punit,price)=>({id:uid(),name,punit,price});
  const ingredients=[
    I('Panino ekmeği','adet',12), I('Dana jambon','kg',480), I('Kaşar peyniri','kg',340),
    I('Taze mozarella','kg',260), I('Domates','kg',30), I('Marul','adet',25),
    I('Salatalık turşusu','kg',90), I('Ev mayonezi','kg',180), I('Acı sucuk','kg',420),
    I('Zeytin ezmesi','kg',220), I('Roka','adet',8)
  ];
  const byN = n => ingredients.find(i=>i.name===n).id;
  const P=(name,price,rec)=>({id:uid(),name,price,recipe:rec.map(([n,a])=>({ingredientId:byN(n),amount:a}))});
  const products=[
    P('Klasik Jambon-Kaşar',155,[['Panino ekmeği',1],['Dana jambon',80],['Kaşar peyniri',50],['Domates',30],['Marul',0.1],['Ev mayonezi',15]]),
    P('Caprese (Mozarella & Domates)',120,[['Panino ekmeği',1],['Taze mozarella',80],['Domates',50],['Roka',0.15],['Ev mayonezi',10]]),
    P('Acılı Sucuk Panino',140,[['Panino ekmeği',1],['Acı sucuk',90],['Kaşar peyniri',40],['Salatalık turşusu',25],['Ev mayonezi',15]]),
    P('Zeytinli Vegeta',110,[['Panino ekmeği',1],['Zeytin ezmesi',50],['Kaşar peyniri',40],['Domates',40],['Marul',0.1]]),
    P('Double Jambon',185,[['Panino ekmeği',1],['Dana jambon',140],['Kaşar peyniri',60]])
  ];
  const costOf=p=>p.recipe.reduce((t,r)=>{
    const ing=ingredients.find(i=>i.id===r.ingredientId);
    return t+ing.price*r.amount/UNITS[ing.punit].f;
  },0);
  const rnd=mulberry32(7); const sales=[];
  for(let d=20;d>=0;d--){
    const date=isoDaysAgo(d);
    const wd=new Date(date+'T12:00:00').getDay();
    const wknd=(wd===0||wd===6);
    products.forEach(p=>{
      const q=Math.round(wknd ? 6+rnd()*10 : 2+rnd()*8);
      if(q>0) sales.push({id:uid(),date,productId:p.id,name:p.name,qty:q,unitPrice:p.price,unitCost:Math.round(costOf(p)*100)/100});
    });
  }
  return {ingredients,products,sales};
}
function load(){
  const r=lsGet(LS); if(!r)return null;
  try{const s=JSON.parse(r);if(s&&Array.isArray(s.ingredients))return s}catch(e){}
  return null;
}
function save(){lsSet(LS,JSON.stringify(state))}
function fresh(){lsDel(LS);return seed()}

state = load() || seed();
